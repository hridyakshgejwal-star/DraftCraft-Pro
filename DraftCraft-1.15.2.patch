+import type {Paragraph,ScriptDocument} from '../types/script';
+import {compactRuns,sliceRuns} from '../production/textRuns';
+import {reconcileStudio} from '../production/model';
+export interface SearchOptions {query:string;matchCase:boolean;wholeWord:boolean}
+export interface SearchOccurrence {paragraphId:string;start:number;end:number;text:string;sourceText:string}
+export function findOccurrences(paragraphs:Paragraph[],options:SearchOptions):SearchOccurrence[]{if(!options.query)return [];const literal=options.query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),word='[\\p{L}\\p{N}\\p{M}_\\u200c\\u200d]',expression=new RegExp(options.wholeWord?'(?<!'+word+')'+literal+'(?!'+word+')':literal,options.matchCase?'gu':'giu');return paragraphs.flatMap(p=>[...p.text.matchAll(expression)].map(m=>({paragraphId:p.id,start:m.index!,end:m.index!+m[0].length,text:m[0],sourceText:p.text})));}
