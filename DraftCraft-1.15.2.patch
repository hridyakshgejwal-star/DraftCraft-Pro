diff --git a/src/production/anchors.ts b/src/production/anchors.ts
new file mode 100644
index 0000000..4fde483
--- /dev/null
+++ b/src/production/anchors.ts
@@ -0,0 +1,50 @@
+import type {Paragraph} from '../types/script';
+
+export interface TextRange {paragraphId: string; start: number; end: number}
+interface Slice {paragraphId: string; sourceStart: number; sourceEnd: number; targetStart: number}
+
+/** Recover exact split/join correspondences. Never search the whole script for
+ * a repeated phrase: an ambiguous match must not attach a prop to another scene. */
+export function structuralSlices(before: Paragraph[], after: Paragraph[]): Map<string, Slice[]> {
+  const oldIds = new Set(before.map(p => p.id)), positions = new Map(after.map((p, i) => [p.id, i])), nextIds = new Set(positions.keys());
+  const result = new Map<string, Slice[]>();
+  for (const old of before) {
+    const at = positions.get(old.id) ?? -1;
+    if (at >= 0 && old.text !== after[at].text) {
+      const pieces = [after[at]];
+      for (let i = at + 1; i < after.length && !oldIds.has(after[i].id); i++) pieces.push(after[i]);
+      if (pieces.length > 1 && pieces.map(p => p.text).join('') === old.text) {
+        let offset = 0;
+        result.set(old.id, pieces.map(p => {
+          const slice = {paragraphId: p.id, sourceStart: offset, sourceEnd: offset + p.text.length, targetStart: 0};
+          offset = slice.sourceEnd; return slice;
+        }));
+      }
+    }
+  }
+  for (let i = 0; i < before.length; i++) {
+    if (!nextIds.has(before[i].id)) continue;
+    const target = after[positions.get(before[i].id)!];
+    const pieces = [before[i]];
+    for (let j = i + 1; j < before.length && !nextIds.has(before[j].id); j++) pieces.push(before[j]);
+    if (pieces.length > 1 && pieces.map(p => p.text).join('') === target.text) {
+      let offset = 0;
+      for (const source of pieces) {
+        result.set(source.id, [{paragraphId: target.id, sourceStart: 0, sourceEnd: source.text.length, targetStart: offset}]);
+        offset += source.text.length;
+      }
+    }
+  }
+  return result;
+}
+
+export function projectStructuralRange(range: TextRange, slices: Map<string, Slice[]>): TextRange[] | undefined {
+  const projection = slices.get(range.paragraphId);
+  if (!projection) return;
+  return projection.flatMap(slice => {
+    const start = Math.max(range.start, slice.sourceStart), end = Math.min(range.end, slice.sourceEnd);
+    const point = range.start === range.end && start === end && start >= slice.sourceStart &&
+      (start < slice.sourceEnd || slice === projection.at(-1));
+    return end > start || point ? [{paragraphId: slice.paragraphId, start: slice.targetStart + start - slice.sourceStart, end: slice.targetStart + end - slice.sourceStart}] : [];
+  });
+}
diff --git a/src/production/fountainInline.ts b/src/production/fountainInline.ts
new file mode 100644
index 0000000..a8d1adb
--- /dev/null
+++ b/src/production/fountainInline.ts
@@ -0,0 +1,48 @@
+import type {InlineStyle, Paragraph, TextRun} from '../types/script';
+
+/** Fountain emphasis is line-local; escaped markers remain literal text. */
+export function parseFountainInline(source: string): {text: string; runs?: TextRun[]} {
+  const runs: TextRun[] = [];
+  const append = (text: string, style: InlineStyle) => {
+    if (!text) return;
+    const last = runs.at(-1);
+    if (last && JSON.stringify(last.style || {}) === JSON.stringify(style)) last.text += text;
+    else runs.push({text, ...(Object.keys(style).length ? {style} : {})});
+  };
+  const parse = (line: string, style: InlineStyle = {}, depth = 0) => {
+    for (let i = 0; i < line.length;) {
+      if (line[i] === '\\' && /[\\*_]/.test(line[i + 1] || '')) { append(line[i + 1], style); i += 2; continue; }
+      const delimiter = ['***', '**', '*', '_'].find(d => line.startsWith(d, i));
+      if (delimiter && depth < 12 && line[i + delimiter.length] && !/\s/.test(line[i + delimiter.length])) {
+        let end = i + delimiter.length;
+        while ((end = line.indexOf(delimiter, end)) >= 0) {
+          let slashes = 0; for (let j = end - 1; j >= 0 && line[j] === '\\'; j--) slashes++;
+          if (!(slashes % 2) && end > i + delimiter.length && !/\s/.test(line[end - 1])) break;
+          end += delimiter.length;
+        }
+        if (end >= 0) {
+          const patch: InlineStyle = delimiter === '_' ? {underline: true} : delimiter === '*' ? {italic: true} : delimiter === '**' ? {bold: true} : {bold: true, italic: true};
+          parse(line.slice(i + delimiter.length, end), {...style, ...patch}, depth + 1); i = end + delimiter.length; continue;
+        }
+      }
+      append(line[i++], style);
+    }
+  };
+  source.split('\n').forEach((line, i) => { if (i) append('\n', {}); parse(line); });
+  return {text: runs.map(r => r.text).join(''), ...(runs.some(r => r.style && Object.keys(r.style).length) ? {runs} : {})};
+}
+
+export function fountainText(p: Paragraph): string {
+  const escape = (text: string) => text.replace(/[\\*_]/g, c => '\\' + c);
+  if (!p.runs?.length || p.runs.map(r => r.text).join('') !== p.text) return escape(p.text);
+  return p.runs.map(run => run.text.split('\n').map(line => {
+    const parts = line.match(/^(\s*)(.*?)(\s*)$/u)!;
+    let content = escape(parts[2]); if (!content) return escape(line);
+    const style = run.style;
+    if (style?.bold && style.italic) content = '***' + content + '***';
+    else if (style?.bold) content = '**' + content + '**';
+    else if (style?.italic) content = '*' + content + '*';
+    if (style?.underline) content = '_' + content + '_';
+    return parts[1] + content + parts[3];
+  }).join('\n')).join('');
+}
