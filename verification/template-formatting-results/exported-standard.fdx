<?xml version="1.0" encoding="UTF-8"?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading">
<Text>INT. STATION - NIGHT</Text></Paragraph>
<Paragraph Type="Action">
<Text>A traveler waits.</Text></Paragraph>
<Paragraph Type="Character">
<Text>ALEX</Text></Paragraph>
<Paragraph Type="Parenthetical">
<Text>(quietly)</Text></Paragraph>
<Paragraph Type="Dialogue">
<Text>Go.</Text></Paragraph>
<Paragraph Type="Transition">
<Text>CUT TO:</Text></Paragraph>
</Content><TitlePage><Content><Paragraph Type="Title"><Text>TEMPLATE QA</Text></Paragraph><Paragraph Type="Author"><Text>QA</Text></Paragraph><Paragraph Type="Based On"><Text></Text></Paragraph><Paragraph Type="Contact"><Text></Text></Paragraph></Content></TitlePage>
