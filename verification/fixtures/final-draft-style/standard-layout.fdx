<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title=""/>
      <Text>INT. LIGHTHOUSE - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Waves hammer the rocks below. MAREN (40s) trims the lamp wick by candlelight.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MAREN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to herself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>One more night. Then the supply boat comes, and somebody else can count the ships.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>TOMAS (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You said that last winter.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <Text>EXT. LIGHTHOUSE GALLERY - CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Shot">
      <Text>ANGLE ON THE HORIZON</Text>
    </Paragraph>
  </Content>

  <TitlePage>
    <Content>
      <Paragraph Type="Title"><Text>THE LAST KEEPER</Text></Paragraph>
      <Paragraph Type="Author"><Text>DraftCraft QA</Text></Paragraph>
    </Content>
  </TitlePage>

